{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "(hmr update|page reload|vite v)"
          },
          "endsPattern": {
            "regexp": "(ready in|Local:)"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "problemMatcher": ["$tsc"]
    }
  ]
}
