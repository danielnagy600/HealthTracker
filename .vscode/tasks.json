{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "detail": "A backend (ASP.NET Core API) fordítása",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/HealthTracker.Api/HealthTracker.Api.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "frontend-serve",
      "detail": "Az Angular fejlesztői szerver (ng serve) indítása (http://localhost:4200)",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/src/HealthTracker.UI" },
      "isBackground": true,
      // Az Angular CLI kimenetéhez igazítva (ugyanaz, mint src/HealthTracker.UI/.vscode/tasks.json):
      // a böngésző akkor indul, amikor elkészült az első build; a TypeScript-hibák
      // a Problems panelen jelennek meg.
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": { "regexp": "Changes detected" },
          "endsPattern": { "regexp": "bundle generation (complete|failed)" }
        }
      }
    },
    {
      "label": "test",
      "detail": "A .NET tesztek futtatása",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/HealthTracker.slnx"],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
